<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero-content">
    <div class="course-chip">📚 AI Fundamentals 1 · FAU Erlangen-Nürnberg</div>
    <h1 class="hero-title">Your AI Study<br><span class="hero-accent">Companion</span> for<br>FAU Students 🎓</h1>
    <p class="hero-sub">Practice questions, flashcards, instant AI feedback and a study forum — everything you need to pass <strong>AI Fundamentals 1</strong>.</p>
    <div class="hero-cta">
      <a href="/student/dashboard" class="lp-btn-primary lp-btn-lg">Start Studying →</a>
      <a href="/auth/register" class="lp-btn-outline lp-btn-lg">Create Account — it's free</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-n">12+</span>
        <span class="stat-l">Topics</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-n">100+</span>
        <span class="stat-l">Questions</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-n">AI</span>
        <span class="stat-l">Graded</span>
      </div>
      <div class="stat-sep"></div>
      <div class="stat">
        <span class="stat-n">Free</span>
        <span class="stat-l">For Students</span>
      </div>
    </div>
  </div>

  <!-- Decorative blobs -->
  <div class="hero-blobs" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>
</section>

<!-- ══ FEATURES ══ -->
<section class="features-section" id="features">
  <div class="section-label">What's inside</div>
  <h2 class="section-title">Everything you need to<br><span class="hero-accent">ace the course</span></h2>

  <div class="features-grid">

    <div class="feature-card fc-lavender">
      <div class="fc-emoji">🎓</div>
      <h3 class="fc-title">Self-Paced Learning</h3>
      <p class="fc-desc">Study at your own speed. Browse 12+ AI Fundamentals topics with summaries, flashcards and podcasts — no deadlines inside the app.</p>
    </div>

    <div class="feature-card fc-mint">
      <div class="fc-emoji">🧠</div>
      <h3 class="fc-title">Adaptive Practice</h3>
      <p class="fc-desc">AI-graded questions that adapt to your level. Get instant, personalised feedback on every answer — like having a tutor 24/7.</p>
    </div>

    <div class="feature-card fc-peach">
      <div class="fc-emoji">⚡</div>
      <h3 class="fc-title">Live Quizzes</h3>
      <p class="fc-desc">Test yourself with timed quizzes. Earn points, climb the leaderboard, and see exactly where you stand among your peers.</p>
    </div>

    <div class="feature-card fc-sky">
      <div class="fc-emoji">🃏</div>
      <h3 class="fc-title">AI Flashcards</h3>
      <p class="fc-desc">Flip-card sessions generated from course material. Mark cards as "known" to focus on what you still need to practice.</p>
    </div>

    <div class="feature-card fc-rose">
      <div class="fc-emoji">📊</div>
      <h3 class="fc-title">Track Your Progress</h3>
      <p class="fc-desc">See your score, topic-by-topic progress, and leaderboard ranking in real time. Stay motivated all semester.</p>
    </div>

    <div class="feature-card fc-yellow">
      <div class="fc-emoji">💬</div>
      <h3 class="fc-title">Student Forum</h3>
      <p class="fc-desc">Ask questions, share tips, and vote on improvements. Your feedback directly shapes the course content.</p>
    </div>

  </div>
</section>

<!-- ══ HOW IT WORKS ══ -->
<section class="how-section">
  <div class="section-label">Simple process</div>
  <h2 class="section-title">Three steps to a better grade</h2>
  <div class="steps-row">
    <div class="step-card">
      <div class="step-num">01</div>
      <h4>Pick a Topic</h4>
      <p>Browse 12+ topics from neural networks to search algorithms — each with a summary and podcast.</p>
    </div>
    <div class="step-arrow">→</div>
    <div class="step-card">
      <div class="step-num">02</div>
      <h4>Study & Practice</h4>
      <p>Flip flashcards, answer questions, and get instant AI feedback to lock in the concepts.</p>
    </div>
    <div class="step-arrow">→</div>
    <div class="step-card">
      <div class="step-num">03</div>
      <h4>Earn Points</h4>
      <p>Every correct answer adds to your score. Climb the leaderboard and stay motivated.</p>
    </div>
  </div>
</section>

<!-- ══ FOOTER ══ -->
<footer class="lp-footer">
  <div class="lp-footer-brand">
    <span style="font-weight:700;color:#5b6af0">StudyAI</span>
    <span class="footer-sep">·</span>
    <span>AI Fundamentals 1 · FAU Erlangen-Nürnberg</span>
  </div>
  <div class="footer-links">
    <a href="/student/dashboard">Dashboard</a>
    <a href="/leaderboard">Leaderboard</a>
    <a href="/forum">Forum</a>
    <a href="/auth/login">Login</a>
  </div>
</footer>

<style>
/* ══ BASE ══ */
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  background: #f7f8fc;
  color: #2d3250;
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}

/* ══ NAV ══ */
.lp-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 2.5rem; height: 62px;
  background: rgba(247,248,252,.9);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(91,106,240,.12);
}
.lp-brand {
  display: flex; align-items: center; gap: .5rem;
  font-size: 1.1rem; font-weight: 800; color: #2d3250;
  text-decoration: none; letter-spacing: -.3px;
}
.brand-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: linear-gradient(135deg, #7b8ff7, #a78bfa);
  flex-shrink: 0;
}
.brand-ai { color: #5b6af0; }
.lp-nav-links { display: flex; align-items: center; gap: 1.5rem; }
.lp-nav-links a {
  color: #4a5180; font-size: .9rem; font-weight: 500;
  text-decoration: none; transition: color .2s;
}
.lp-nav-links a:hover { color: #5b6af0; }

/* Buttons */
.lp-btn-primary {
  display: inline-flex; align-items: center; gap: .35rem;
  background: linear-gradient(135deg, #5b6af0, #7b8ff7);
  color: #fff !important; padding: .5rem 1.3rem; border-radius: 10px;
  font-weight: 700; font-size: .88rem; text-decoration: none !important;
  box-shadow: 0 4px 14px rgba(91,106,240,.28);
  transition: box-shadow .2s, transform .15s;
}
.lp-btn-primary:hover { box-shadow: 0 6px 20px rgba(91,106,240,.38); transform: translateY(-1px); }
.lp-btn-lg { padding: .72rem 2rem; font-size: .98rem; border-radius: 12px; }

.lp-btn-ghost {
  color: #4a5180 !important; font-size: .88rem; font-weight: 600;
  text-decoration: none !important; transition: color .2s;
}
.lp-btn-ghost:hover { color: #5b6af0 !important; }

.lp-btn-outline {
  display: inline-flex; align-items: center;
  color: #5b6af0 !important;
  border: 2px solid rgba(91,106,240,.35); border-radius: 12px;
  padding: .72rem 2rem; font-size: .98rem; font-weight: 600;
  text-decoration: none !important; transition: all .2s; background: #fff;
}
.lp-btn-outline:hover { border-color: #5b6af0; background: rgba(91,106,240,.05); }

/* ══ HERO ══ */
.hero {
  position: relative; min-height: 100vh;
  display: flex; align-items: center; justify-content: center;
  padding: 8rem 2rem 5rem; overflow: hidden;
}
.hero-content {
  position: relative; z-index: 1;
  max-width: 680px; text-align: center;
}
.course-chip {
  display: inline-block;
  background: #ede9fe; color: #6d4fc2;
  font-size: .78rem; font-weight: 700; letter-spacing: .4px;
  padding: .35rem 1.1rem; border-radius: 99px;
  margin-bottom: 1.6rem; border: 1.5px solid rgba(109,79,194,.18);
}
.hero-title {
  font-size: clamp(2.2rem, 5.5vw, 3.5rem);
  font-weight: 800; line-height: 1.2; color: #1e2356;
  margin-bottom: 1.2rem; letter-spacing: -.5px;
}
.hero-accent {
  background: linear-gradient(135deg, #5b6af0, #a78bfa);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-sub {
  color: #5d6494; font-size: 1.07rem; line-height: 1.75;
  max-width: 540px; margin: 0 auto 2.2rem;
}
.hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.5rem; }

.hero-stats {
  display: inline-flex; align-items: center; gap: 1.2rem;
  background: #fff; border: 1.5px solid rgba(91,106,240,.15);
  border-radius: 16px; padding: .8rem 2rem;
  box-shadow: 0 4px 24px rgba(91,106,240,.08);
}
.stat { display: flex; flex-direction: column; align-items: center; gap: .1rem; }
.stat-n { font-size: 1.35rem; font-weight: 800; color: #2d3250; }
.stat-l { font-size: .68rem; color: #8891b8; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
.stat-sep { width: 1px; height: 34px; background: rgba(91,106,240,.15); }

/* Blobs */
.hero-blobs { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.blob {
  position: absolute; border-radius: 50%;
  filter: blur(70px); opacity: .55;
}
.blob-1 { width: 480px; height: 480px; background: #ddd8f8; top: -80px; left: -100px; }
.blob-2 { width: 380px; height: 380px; background: #fce4f0; bottom: 20px; right: -60px; }
.blob-3 { width: 300px; height: 300px; background: #d1f3ef; top: 50%; left: 60%; transform: translate(-50%,-50%); }

/* ══ FEATURES ══ */
.features-section {
  max-width: 1160px; margin: 0 auto;
  padding: 5rem 2rem; text-align: center;
}
.section-label {
  font-size: .72rem; font-weight: 800; text-transform: uppercase;
  letter-spacing: 2px; color: #7b8ff7; margin-bottom: .6rem;
}
.section-title {
  font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 800;
  color: #1e2356; margin-bottom: 3rem; line-height: 1.3;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.3rem; text-align: left;
}
.feature-card {
  border-radius: 20px; padding: 1.8rem 1.6rem;
  border: 1.5px solid transparent;
  transition: transform .25s, box-shadow .25s;
}
.feature-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(91,106,240,.12); }

.fc-lavender { background: #eeeafd; border-color: #d5ccf9; }
.fc-mint     { background: #e3f5ee; border-color: #b8e8d0; }
.fc-peach    { background: #fdeee6; border-color: #f7cdb4; }
.fc-sky      { background: #e2f0fd; border-color: #b3d6f8; }
.fc-rose     { background: #fde8ed; border-color: #f5bfcc; }
.fc-yellow   { background: #fef8e3; border-color: #f5e29a; }

.fc-emoji { font-size: 2rem; margin-bottom: .75rem; }
.fc-title {
  font-size: 1.08rem; font-weight: 800; color: #1e2356;
  margin-bottom: .5rem;
}
.fc-desc { color: #545b7c; font-size: .9rem; line-height: 1.7; margin: 0; }

/* ══ HOW IT WORKS ══ */
.how-section {
  background: #fff;
  border-top: 1.5px solid rgba(91,106,240,.1);
  border-bottom: 1.5px solid rgba(91,106,240,.1);
  padding: 5rem 2rem; text-align: center;
}
.steps-row {
  display: flex; align-items: flex-start;
  justify-content: center; gap: 1rem;
  flex-wrap: wrap; margin-top: 2.5rem;
  max-width: 900px; margin-left: auto; margin-right: auto;
}
.step-card {
  flex: 1; min-width: 200px; max-width: 240px;
  background: #f7f8fc; border: 1.5px solid rgba(91,106,240,.1);
  border-radius: 18px; padding: 1.6rem 1.4rem; text-align: center;
}
.step-num {
  font-size: 2rem; font-weight: 900;
  background: linear-gradient(135deg, #5b6af0, #a78bfa);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; margin-bottom: .5rem;
}
.step-card h4 { color: #1e2356; font-size: 1rem; font-weight: 700; margin-bottom: .4rem; }
.step-card p  { color: #6b7494; font-size: .87rem; line-height: 1.65; margin: 0; }
.step-arrow {
  font-size: 1.4rem; color: #b8bdd8;
  padding-top: 2.5rem; flex-shrink: 0; align-self: flex-start;
}

/* ══ FOOTER ══ */
.lp-footer {
  background: #f0f2fa;
  border-top: 1px solid rgba(91,106,240,.12);
  padding: 1.4rem 2.5rem;
  display: flex; align-items: center;
  justify-content: space-between; flex-wrap: wrap; gap: 1rem;
}
.lp-footer-brand {
  display: flex; align-items: center; gap: .6rem;
  font-size: .85rem; color: #6b7494;
}
.footer-sep { color: #b8bdd8; }
.footer-links { display: flex; gap: 1.4rem; flex-wrap: wrap; }
.footer-links a {
  color: #6b7494; font-size: .82rem;
  text-decoration: none; transition: color .2s;
}
.footer-links a:hover { color: #5b6af0; }

/* ══ RESPONSIVE ══ */
@media (max-width: 640px) {
  .lp-nav { padding: 0 1.2rem; }
  .lp-nav-links a:not(.lp-btn-primary):not(.lp-btn-ghost) { display: none; }
  .step-arrow { display: none; }
  .hero-stats { gap: .8rem; padding: .7rem 1.2rem; }
}
</style>

</body>
</html>
