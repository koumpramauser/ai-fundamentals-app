  <a href="/" class="lp-brand">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/75/FAU_Logo.svg/200px-FAU_Logo.svg.png"
         alt="FAU" style="height:28px;filter:brightness(0) invert(1);opacity:.9" />
    <span>Study<span style="color:#7ab3f0">AI</span></span>
